<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#15161D" />
    <SolidColorBrush x:Key="ScrollTrackHoverBrush" Color="#1B1C23" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#555A73" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#707696" />
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#9B7CFF" />
    <SolidColorBrush x:Key="ScrollThumbBorderBrush" Color="#34364A" />
    <SolidColorBrush x:Key="TabScrollTrackBrush" Color="#1A1B25" />
    <SolidColorBrush x:Key="TabScrollThumbBrush" Color="#626684" />
    <SolidColorBrush x:Key="TabScrollThumbHoverBrush" Color="#7F84A8" />

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="CanContentScroll" Value="True" />
        <Setter Property="PanningMode" Value="Both" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
    </Style>

    <Style TargetType="{x:Type ListView}">
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="ScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{StaticResource TransparentBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppVerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbRoot"
                            Margin="1"
                            Background="{StaticResource ScrollThumbBrush}"
                            BorderBrush="{StaticResource ScrollThumbBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                            <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                            <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppHorizontalScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbRoot"
                            Margin="1"
                            Background="{StaticResource ScrollThumbBrush}"
                            BorderBrush="{StaticResource ScrollThumbBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                            <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                            <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabHorizontalScrollThumbStyle" TargetType="{x:Type Thumb}" BasedOn="{StaticResource AppHorizontalScrollThumbStyle}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbRoot"
                            Margin="2"
                            Background="{StaticResource TabScrollThumbBrush}"
                            BorderBrush="{StaticResource ScrollThumbHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="8" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource TabScrollThumbHoverBrush}" />
                            <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbPressedBrush}" />
                            <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="{StaticResource PrimaryBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="AppVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="14"
              MinWidth="14"
              Margin="3,2,2,2"
              Background="{StaticResource TransparentBrush}"
              SnapsToDevicePixels="True">
            <Border x:Name="TrackRoot"
                    Background="{StaticResource ScrollTrackBrush}"
                    BorderBrush="{StaticResource ScrollThumbBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7" />
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="52" MinWidth="14" Style="{StaticResource AppVerticalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackRoot" Property="Background" Value="{StaticResource ScrollTrackHoverBrush}" />
                <Setter TargetName="TrackRoot" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="AppHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="14"
              MinHeight="14"
              Margin="2,3,2,2"
              Background="{StaticResource TransparentBrush}"
              SnapsToDevicePixels="True">
            <Border x:Name="TrackRoot"
                    Background="{StaticResource ScrollTrackBrush}"
                    BorderBrush="{StaticResource ScrollThumbBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="80" MinHeight="14" Style="{StaticResource AppHorizontalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackRoot" Property="Background" Value="{StaticResource ScrollTrackHoverBrush}" />
                <Setter TargetName="TrackRoot" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="TabStripHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="16"
              MinHeight="16"
              Margin="4,4,4,0"
              Background="{StaticResource TransparentBrush}"
              SnapsToDevicePixels="True">
            <Border x:Name="TrackRoot"
                    Background="{StaticResource TabScrollTrackBrush}"
                    BorderBrush="{StaticResource ScrollThumbBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" />
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="120" MinHeight="16" Style="{StaticResource TabHorizontalScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollBarRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackRoot" Property="Background" Value="{StaticResource ScrollTrackHoverBrush}" />
                <Setter TargetName="TrackRoot" Property="BorderBrush" Value="{StaticResource ScrollThumbHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AppScrollBarVerticalStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ScrollThumbBrush}" />
        <Setter Property="Template" Value="{StaticResource AppVerticalScrollBarTemplate}" />
    </Style>

    <Style x:Key="AppScrollBarHorizontalStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Height" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ScrollThumbBrush}" />
        <Setter Property="Template" Value="{StaticResource AppHorizontalScrollBarTemplate}" />
    </Style>

    <Style x:Key="TabStripHorizontalScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarHorizontalStyle}">
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Background" Value="{StaticResource TabScrollTrackBrush}" />
        <Setter Property="Template" Value="{StaticResource TabStripHorizontalScrollBarTemplate}" />
    </Style>

    <Style x:Key="DataGridScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarVerticalStyle}">
        <Setter Property="Margin" Value="2" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Template" Value="{StaticResource AppHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarVerticalStyle}">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="Template" Value="{StaticResource AppHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
