<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#0A0B10</Color>
    <Color x:Key="BackgroundAltColor">#10111A</Color>
    <Color x:Key="SurfaceLowColor">#14151D</Color>
    <Color x:Key="SurfaceColor">#1A1B25</Color>
    <Color x:Key="SurfaceContainerColor">#1A1B25</Color>
    <Color x:Key="SurfaceHighColor">#232533</Color>
    <Color x:Key="SurfaceGlassColor">#242638</Color>
    <Color x:Key="SurfaceVariantColor">#2D3042</Color>
    <Color x:Key="TextPrimaryColor">#F7F3FF</Color>
    <Color x:Key="TextSecondaryColor">#D6D0E1</Color>
    <Color x:Key="MutedTextColor">#AAA3B8</Color>
    <Color x:Key="DisabledTextColor">#8A8396</Color>
    <Color x:Key="PrimaryColor">#A78BFA</Color>
    <Color x:Key="PrimaryBrightColor">#C4B5FD</Color>
    <Color x:Key="OnPrimaryColor">#FAF7FF</Color>
    <Color x:Key="PrimaryContainerColor">#3C2A63</Color>
    <Color x:Key="OnPrimaryContainerColor">#F0E5FF</Color>
    <Color x:Key="PrimaryGlowColor">#8B5CF6</Color>
    <Color x:Key="AccentSoftColor">#6F52C4</Color>
    <Color x:Key="SelectionColor">#342A52</Color>
    <Color x:Key="SecondaryColor">#8EA7FF</Color>
    <Color x:Key="CyanAccentColor">#7DD3FC</Color>
    <Color x:Key="SecondaryContainerColor">#433D53</Color>
    <Color x:Key="SuccessColor">#8FDB9D</Color>
    <Color x:Key="SuccessContainerColor">#173822</Color>
    <Color x:Key="WarningColor">#F0CF73</Color>
    <Color x:Key="WarningContainerColor">#433607</Color>
    <Color x:Key="ErrorColor">#F2B8B5</Color>
    <Color x:Key="ErrorContainerColor">#5F1713</Color>
    <Color x:Key="InfoColor">#A9C8FA</Color>
    <Color x:Key="InfoContainerColor">#173656</Color>
    <Color x:Key="OutlineColor">#4A4D66</Color>
    <Color x:Key="OutlineVariantColor">#34364A</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundAltBrush" Color="{StaticResource BackgroundAltColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceLowBrush" Color="{StaticResource SurfaceLowColor}" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="{StaticResource SurfaceGlassColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryBrightBrush" Color="{StaticResource PrimaryBrightColor}" />
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource PrimaryGlowColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccentColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessContainerBrush" Color="{StaticResource SuccessContainerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningContainerBrush" Color="{StaticResource WarningContainerColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoContainerBrush" Color="{StaticResource InfoContainerColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="#00000000" />
</ResourceDictionary>
