<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="Effect" Value="{StaticResource CardHoverShadowEffect}" />
            </Trigger>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.006" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOutCubic}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.006" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOutCubic}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOutCubic}" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOutCubic}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompactCardBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="15" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="MaxWidth" Value="370" />
    </Style>

    <Style x:Key="InfoBannerBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource InfoContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,14,14" />
    </Style>

    <Style x:Key="HeroCardBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{StaticResource HeroGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{StaticResource SubtleGlowEffect}" />
    </Style>

    <Style x:Key="WarningBannerBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource InfoBannerBorderStyle}">
        <Setter Property="Background" Value="{StaticResource WarningContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,5,5" />
    </Style>

    <Style x:Key="PrimaryChipBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
    </Style>

    <Style x:Key="SuccessChipBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
    </Style>

    <Style x:Key="WarningChipBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{StaticResource WarningContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    </Style>
</ResourceDictionary>
