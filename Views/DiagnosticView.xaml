<UserControl x:Class="NokaraSystemManager.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Diagnóstico" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Text="Stuttering, RAM, almacenamiento, red, streaming, juegos detectados y reporte final sin tweaks peligrosos." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

        <Border Style="{StaticResource HeroCardBorderStyle}" MaxWidth="980">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnóstico completo V1.1.0" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,12" />
                    <WrapPanel>
                        <Border Style="{StaticResource SuccessChipBorderStyle}">
                            <TextBlock Text="Seguro primero" Style="{StaticResource ChipTextStyle}" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Text="Sin BCDEDIT / HPET / drivers" Style="{StaticResource ChipTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Text="chkdsk solo /scan" Style="{StaticResource ChipTextStyle}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button Content="Analizar" Command="{Binding AnalyzeCommand}" />
                    <Button Content="Reporte final" Command="{Binding GenerateReportCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Buscar errores" Command="{Binding StorageScanCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </WrapPanel>
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CompactCardBorderStyle}" Width="305" MinHeight="245">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource PrimaryChipBorderStyle}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource ChipTextStyle}" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding State}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Problems, StringFormat=Detectado: {0}}" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding SuggestedActions, StringFormat=Sugerido: {0}}" Style="{StaticResource MetaTextStyle}" />
                                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource MetaTextStyle}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="Analizar" Command="{Binding DataContext.AnalyzeCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="Aplicar" Command="{Binding DataContext.ApplyCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanApply}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="980">
            <StackPanel>
                <TextBlock Text="Detalle" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{Binding LastReportPath, StringFormat=Último reporte: {0}}" Style="{StaticResource MetaTextStyle}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <WrapPanel>
            <Border Style="{StaticResource CardBorderStyle}" Width="430" MinHeight="230">
                <StackPanel>
                    <TextBlock Text="Top RAM" Style="{StaticResource SectionTitleTextStyle}" />
                    <DataGrid ItemsSource="{Binding TopRamProcesses}" MaxHeight="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proceso" Binding="{Binding DisplayName}" Width="150" />
                            <DataGridTextColumn Header="RAM" Binding="{Binding MemoryMB}" Width="70" />
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Width="430" MinHeight="230">
                <StackPanel>
                    <TextBlock Text="Almacenamiento" Style="{StaticResource SectionTitleTextStyle}" />
                    <DataGrid ItemsSource="{Binding Storage}" MaxHeight="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Root}" Width="70" />
                            <DataGridTextColumn Header="Libre" Binding="{Binding FreeDisplay}" Width="90" />
                            <DataGridTextColumn Header="%" Binding="{Binding FreePercent}" Width="55" />
                            <DataGridTextColumn Header="Salud" Binding="{Binding HealthStatus}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
