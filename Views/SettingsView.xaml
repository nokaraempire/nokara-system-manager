<UserControl x:Class="NokaraSystemManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Ajustes" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

        <WrapPanel>
            <Border Style="{StaticResource CardBorderStyle}" Width="430">
                <StackPanel>
                    <TextBlock Text="Modo de uso" Style="{StaticResource SectionTitleTextStyle}" />
                    <CheckBox Content="Confirmaciones extra para acciones sensibles" IsChecked="{Binding ExtraConfirmations}" />
                    <CheckBox Content="Modo avanzado" IsChecked="{Binding ExpertMode}" />
                    <TextBlock Text="Modo básico prioriza acciones comunes. Modo avanzado muestra acciones medias/altas, pero mantiene confirmaciones." Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Width="430">
                <StackPanel>
                    <TextBlock Text="Preferencias" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="DNS preferido" Style="{StaticResource SecondaryTextStyle}" />
                    <ComboBox ItemsSource="{Binding DnsProviderNames}" SelectedItem="{Binding PreferredDnsProvider}" Width="220" HorizontalAlignment="Left" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Guardar" Command="{Binding SaveCommand}" />
                        <Button Content="Restablecer" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="900">
            <StackPanel>
                <TextBlock Text="Rutas locales" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="{Binding LogsPath, StringFormat=Logs: {0}}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{Binding BackupsPath, StringFormat=Backups: {0}}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{Binding ConfigPath, StringFormat=Config: {0}}" Style="{StaticResource SecondaryTextStyle}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Abrir datos" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Abrir logs" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Abrir backups" Command="{Binding OpenBackupsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Abrir config" Command="{Binding OpenConfigFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="900">
            <StackPanel>
                <TextBlock Text="Configuración" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="Exportar crea un JSON en Config. Importar toma el export más reciente si existe; si no, queda pendiente con motivo visible." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />
                <WrapPanel>
                    <Button Content="Exportar configuración" Command="{Binding ExportSettingsCommand}" />
                    <Button Content="Importar configuración" Command="{Binding ImportSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
