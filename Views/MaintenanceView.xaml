<UserControl x:Class="NokaraSystemManager.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NokaraSystemManager.Views">
    <StackPanel>
        <TextBlock Text="Mantenimiento" Style="{StaticResource PageTitleTextStyle}" />
        <WrapPanel Margin="0,0,0,8">
            <Button Content="Recalcular espacio" Command="{Binding RefreshEstimateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
        </WrapPanel>

        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="900">
            <StackPanel>
                <TextBlock Text="Espacio estimado" Style="{StaticResource SectionTitleTextStyle}" />
                <DataGrid ItemsSource="{Binding Estimates}" MaxHeight="170">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Area" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeDisplay}" Width="90" />
                        <DataGridCheckBoxColumn Header="Admin" Binding="{Binding RequiresAdmin}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <TextBlock Text="Acciones" Style="{StaticResource SectionTitleTextStyle}" />
        <ItemsControl ItemsSource="{Binding Actions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:ActionCardControl />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
