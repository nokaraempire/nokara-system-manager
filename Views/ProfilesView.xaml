<UserControl x:Class="NokaraSystemManager.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Perfiles" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="920">
            <StackPanel>
                <TextBlock Text="{Binding ProfileName}" Style="{StaticResource SectionTitleTextStyle}" />
                <WrapPanel>
                    <Button Content="Gaming" Command="{Binding LoadGamingCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Streaming" Command="{Binding LoadStreamingCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Diagnóstico completo" Command="{Binding LoadDiagnosticCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Restauración" Command="{Binding LoadRestoreCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Ejecutar selección" Command="{Binding ExecuteProfileCommand}" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Steps}" MaxHeight="340" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Usar" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Paso" Binding="{Binding Name}" Width="190" IsReadOnly="True" />
                        <DataGridTextColumn Header="Modulo" Binding="{Binding Module}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="Riesgo" Binding="{Binding RiskLevel}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
