<UserControl x:Class="NokaraSystemManager.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding AppName}" Style="{StaticResource PageTitleTextStyle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,14" />

        <Border Style="{StaticResource HeroCardBorderStyle}" MaxWidth="920">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="58" Height="58" CornerRadius="20" Background="{StaticResource PrimaryContainerBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <TextBlock Text="N" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Nokara System Manager" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Gaming, Streaming &amp; Maintenance Toolkit" Style="{StaticResource SecondaryTextStyle}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource PrimaryChipBorderStyle}">
                            <TextBlock Text="{Binding Version, StringFormat=Versión {0}}" Style="{StaticResource ChipTextStyle}" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Text="{Binding Creator, StringFormat=Creado por {0}}" Style="{StaticResource ChipTextStyle}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Text="{Binding Developer, StringFormat=Dev {0}}" Style="{StaticResource ChipTextStyle}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel>
            <Border Style="{StaticResource CardBorderStyle}" Width="430" MinHeight="220">
                <StackPanel>
                    <TextBlock Text="Créditos" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="{Binding Creator, StringFormat=Creado por: {0}}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding Developer, StringFormat=Desarrollado por: {0}}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="Herramienta de mantenimiento, gaming, streaming, diagnóstico y reparación segura de Windows con logs, backups, reportes y reversión." Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding DataPath, StringFormat=Datos locales: {0}}" Style="{StaticResource MetaTextStyle}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Width="430" MinHeight="220">
                <StackPanel>
                    <TextBlock Text="Seguridad" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="{Binding SafetyNote}" Style="{StaticResource SecondaryTextStyle}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Copiar info sistema" Command="{Binding CopySystemInfoCommand}" />
                        <Button Content="Abrir logs" Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="920">
            <StackPanel>
                <TextBlock Text="Nokara Empire" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="Links públicos del proyecto. Si un canal todavía no está configurado, queda marcado como próximamente." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding SocialLinks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ButtonText}"
                                    Command="{Binding DataContext.OpenSocialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
