<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NokaraSystemManager</RootNamespace>
    <AssemblyName>NokaraSystemManager</AssemblyName>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>Nokara System Manager</Product>
    <Company>Nokara</Company>
    <Description>Gaming, Streaming &amp; Maintenance Toolkit</Description>
    <AssemblyTitle>Gaming, Streaming &amp; Maintenance Toolkit</AssemblyTitle>
    <FileDescription>Gaming, Streaming &amp; Maintenance Toolkit</FileDescription>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Config\known-processes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Config\social-links.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
